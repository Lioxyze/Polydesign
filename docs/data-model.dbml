Project PolyDesign {
  database_type: 'MySQL'
}

Enum model_status {
  draft
  published
  removed
}

Enum visibility {
  public
  unlisted
  private
}

Enum model_type {
  cgi
  print_3d
}

Enum geometry {
  polygon_mesh
  subdivision
  nurbs
  mixed
}

Enum uv_unwrapping {
  yes
  no
  overlapping
  mixed
}

Enum file_format {
  glb
  gltf
  fbx
  obj
  stl
  blend
  usdz
}

Enum upload_status {
  pending
  uploaded
  rejected
}

Enum subscription_status {
  active
  canceled
  expired
}

Enum token_type {
  email_verification
  password_reset
}

Enum link_platform {
  website
  artstation
  sketchfab
  instagram
  youtube
  x
}

Enum report_status {
  pending
  resolved
  rejected
}

TableGroup accounts {
  roles
  users
  subscriptions
  user_tokens
  refresh_tokens
  user_links
  follows
}

TableGroup catalog {
  categories
  licenses
  tags
  models
  model_files
  model_tags
  model_images
}

TableGroup community {
  downloads
  model_views
  comments
  ratings
  likes
  favorites
  collections
  collection_models
  reports
}

Table roles {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
}

Table users {
  id int [pk, increment]
  email varchar(180) [not null, unique]
  password_hash varchar(255) [not null]
  username varchar(50) [not null, unique]
  first_name varchar(100)
  last_name varchar(100)
  bio text
  avatar_key varchar(500)
  gdpr_accepted_at datetime
  email_verified_at datetime
  failed_login_attempts smallint [not null, default: 0]
  locked_until datetime
  is_active boolean [not null, default: true]
  deleted_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null]
  role_id int [not null, ref: > roles.id]
}

Table subscriptions {
  id int [pk, increment]
  plan varchar(30) [not null, default: 'premium_monthly']
  status subscription_status [not null, default: 'active']
  starts_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  ends_at datetime [not null]
  payment_reference varchar(255)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  user_id int [not null, ref: > users.id]

  indexes {
    (user_id, ends_at)
  }
}

Table user_tokens {
  id int [pk, increment]
  type token_type [not null]
  token_hash char(64) [not null, unique]
  expires_at datetime [not null]
  used_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  user_id int [not null, ref: > users.id]

  indexes {
    (user_id, type)
  }
}

Table refresh_tokens {
  id int [pk, increment]
  token_hash char(64) [not null, unique]
  expires_at datetime [not null]
  revoked_at datetime
  user_agent varchar(255)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  user_id int [not null, ref: > users.id]
}

Table user_links {
  id int [pk, increment]
  platform link_platform [not null]
  url varchar(500) [not null]
  user_id int [not null, ref: > users.id]

  indexes {
    (user_id, platform) [unique]
  }
}

Table follows {
  follower_id int [ref: > users.id]
  creator_id int [ref: > users.id]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (follower_id, creator_id) [pk]
  }
}

Table categories {
  id int [pk, increment]
  name varchar(80) [not null]
  slug varchar(100) [not null, unique]
  parent_id int [ref: > categories.id]

  indexes {
    (parent_id, name) [unique]
  }
}

Table licenses {
  id int [pk, increment]
  name varchar(120) [not null, unique]
  commercial_use boolean [not null, default: false]
  modifications_allowed boolean [not null, default: false]
}

Table tags {
  id int [pk, increment]
  name varchar(50) [not null, unique]
}

Table models {
  id int [pk, increment]
  title varchar(150) [not null]
  slug varchar(180) [not null, unique]
  description text
  status model_status [not null, default: 'draft']
  visibility visibility [not null, default: 'public']
  model_type model_type [not null, default: 'cgi']
  is_premium boolean [not null, default: false]
  is_downloadable boolean [not null, default: true]
  allow_comments boolean [not null, default: true]
  is_ai_generated boolean [not null, default: false]
  is_age_restricted boolean [not null, default: false]
  has_textures boolean [not null, default: false]
  has_materials boolean [not null, default: false]
  is_pbr boolean [not null, default: false]
  is_rigged boolean [not null, default: false]
  is_animated boolean [not null, default: false]
  is_game_ready boolean [not null, default: false]
  uv_unwrapping uv_unwrapping
  geometry geometry
  polygon_count int
  vertex_count int
  software varchar(100)
  plugins_used varchar(255)
  version varchar(20) [not null, default: '1.0']
  download_count int [not null, default: 0]
  view_count int [not null, default: 0]
  published_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null]
  user_id int [not null, ref: > users.id]
  category_id int [not null, ref: > categories.id]
  license_id int [not null, ref: > licenses.id]

  indexes {
    (status, visibility, published_at)
    category_id
    user_id
  }
}

Table model_files {
  id int [pk, increment]
  file_name varchar(255) [not null]
  format file_format [not null]
  mime_type varchar(100) [not null]
  size_bytes bigint [not null]
  checksum_sha256 char(64)
  storage_key varchar(500) [not null, unique]
  upload_status upload_status [not null, default: 'pending']
  uploaded_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  model_id int [not null, ref: > models.id]

  indexes {
    model_id
    format
  }
}

Table model_tags {
  model_id int [ref: > models.id]
  tag_id int [ref: > tags.id]

  indexes {
    (model_id, tag_id) [pk]
  }
}

Table model_images {
  id int [pk, increment]
  storage_key varchar(500) [not null, unique]
  mime_type varchar(50) [not null]
  position tinyint [not null, default: 0]
  upload_status upload_status [not null, default: 'pending']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  model_id int [not null, ref: > models.id]

  indexes {
    (model_id, position) [unique]
  }
}

Table downloads {
  id bigint [pk, increment]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  user_id int [not null, ref: > users.id]
  model_id int [not null, ref: > models.id]
  file_id int [ref: > model_files.id]

  indexes {
    (user_id, created_at)
    (model_id, created_at)
  }
}

Table model_views {
  id bigint [pk, increment]
  ip_hash char(64) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  model_id int [not null, ref: > models.id]

  indexes {
    (model_id, ip_hash, created_at)
  }
}

Table comments {
  id int [pk, increment]
  content text [not null]
  is_hidden boolean [not null, default: false]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null]
  user_id int [not null, ref: > users.id]
  model_id int [not null, ref: > models.id]
  parent_id int [ref: > comments.id]

  indexes {
    (model_id, created_at)
    parent_id
  }
}

Table ratings {
  user_id int [ref: > users.id]
  model_id int [ref: > models.id]
  score tinyint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null]

  indexes {
    (user_id, model_id) [pk]
  }
}

Table likes {
  user_id int [ref: > users.id]
  model_id int [ref: > models.id]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, model_id) [pk]
  }
}

Table favorites {
  user_id int [ref: > users.id]
  model_id int [ref: > models.id]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, model_id) [pk]
  }
}

Table collections {
  id int [pk, increment]
  name varchar(100) [not null]
  description varchar(500)
  is_public boolean [not null, default: false]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  user_id int [not null, ref: > users.id]
}

Table collection_models {
  collection_id int [ref: > collections.id]
  model_id int [ref: > models.id]
  added_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (collection_id, model_id) [pk]
  }
}

Table reports {
  id int [pk, increment]
  reason varchar(120) [not null]
  details text
  status report_status [not null, default: 'pending']
  resolved_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  user_id int [not null, ref: > users.id]
  model_id int [not null, ref: > models.id]
  resolved_by_id int [ref: > users.id]

  indexes {
    (status, created_at)
  }
}
