# Copy this file to .env and adjust the values if needed.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# MySQL (docker compose service "mysql")
DATABASE_URL=mysql://polydesign:polydesign@localhost:3306/polydesign

# Authentication — use a long random value (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=15m

# Object storage (docker compose service "minio", S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=polydesign
S3_ACCESS_KEY=polydesign
S3_SECRET_KEY=polydesign-secret

# E-mails (docker compose service "mailpit", UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="PolyDesign <no-reply@polydesign.local>"
